<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zjjxy</groupId>
        <artifactId>father_project</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>doc-service</artifactId>

    <!-- 文档服务：上传 / 解析 / 切片 / 版本化 → 入库 → 发 Kafka 事件。
         actuator、prometheus、starter-test 已由父 pom 统一给，这里不重复写。 -->
    <dependencies>
        <!-- Web：对外提供 /doc/** 接口（含 multipart 文件上传） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 注册到 Nacos，gateway 的 lb://doc-service 才能找到它 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- OpenFeign：调 ai-service（Text2SQL 生成 SQL 走这里） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- Feign 用 lb://服务名 调度，靠 loadbalancer；没有它会报 "No load balancer available" -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- 熔断降级：ai-service 挂了时 upload 仍能返回兜底结果 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- ★补：AOP。方法级权限切面 @RequirePermission 需要它，缺了注解不生效还不报错 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- MyBatis-Plus：读写 doc_db 的 kb_document / kb_document_version -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 8 驱动：只在运行期需要 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ★补：Kafka 生产者。文档入库后发「文档已索引」事件，search-service 靠它建索引 -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- ★补：PDF 解析。PDFBox 3.x 的入口是 Loader.loadPDF()，2.x 的 PDDocument.load() 已移除 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- ★补：Word(.docx) 解析。poi-ooxml 自带 poi 核心包，不用再单独引 poi -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

    </dependencies>

</project>
